# Copy to .env (gitignored). Read at build time and compiled into the binary.
PENGUIN_MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
PENGUIN_MS_TENANT=00000000-0000-0000-0000-000000000000

# Optional push relay (see docs/relay-architecture.md). The URL is public.
# PENGUIN_MS_RELAY_URL=https://relay.example.com
# The invite secret registers this device with the relay. Compiled in if set here, but anyone
# with the binary can read it: for a shared build leave it out and put it in
# ~/.config/penguin-ms-suite/relay_invite (or the PENGUIN_MS_RELAY_INVITE environment variable).
# PENGUIN_MS_RELAY_INVITE=
